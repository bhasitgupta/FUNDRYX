# Fundryx Frontend Environment Variables
# Copy to .env.local or set in Vercel project settings

# Blockchain Network
VITE_CHAIN_ID=80002
VITE_POLYGON_AMOY_RPC=https://polygon-amoy-bor-rpc.publicnode.com

# Supabase Audit Trail Configuration
# Obtain from your Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here

# WalletConnect Project ID
VITE_WALLETCONNECT_PROJECT_ID=3a8170812b534d0ff9d794f19a901d64

# Cross-Chain Bridge & Multi-Chain Protocol Environment
VITE_CROSS_CHAIN_ENABLED=true
VITE_BRIDGE_ENVIRONMENT=active
VITE_CCIP_ROUTER_POLYGON_AMOY=0x9C32fCB86BF0f4a1A8921a9Fe46de3198bb884B2
VITE_CCIP_ROUTER_AVAX_FUJI=0xF694E193200268f9a4868e4Aa017A0118C9a8177
VITE_CCIP_ROUTER_BASE=0x881e3A65B4d5947d191348b9487c06282E37B304
VITE_MONAD_TESTNET_RPC=https://testnet-rpc.monad.xyz/
VITE_AVAX_FUJI_RPC=https://api.avax-test.network/ext/bc/C/rpc
VITE_BASE_RPC=https://mainnet.base.org
