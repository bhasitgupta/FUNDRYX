# Fundrex Frontend Environment Configuration
# Copy to .env or .env.local — NEVER commit live secrets to git.

# ── DEFAULT BROWSER CONNECTION ──────────────────────────────────
VITE_CHAIN_ID=80002
VITE_NETWORK_MODE=testnet # 'testnet' | 'mainnet'

# ── TESTNET RPCS (FOUR-CHAIN TESTNET ARCHITECTURE) ──────────────
# Polygon Amoy (80002) - Protocol Live
VITE_POLYGON_AMOY_RPC=https://polygon-amoy-bor-rpc.publicnode.com
# Monad Testnet (10143) - Staging / Pending Receiver Deployment
VITE_MONAD_TESTNET_RPC=https://testnet-rpc.monad.xyz/
# Base Sepolia (84532) - Staging / Pending Receiver Deployment
VITE_BASE_SEPOLIA_RPC=https://sepolia.base.org
# Avalanche Fuji (43113) - Staging / Pending Receiver Deployment
VITE_AVAX_FUJI_RPC=https://api.avax-test.network/ext/bc/C/rpc

# ── MAINNET RPCS (FOUR-CHAIN MAINNET ARCHITECTURE) ──────────────
# Polygon PoS (137) - LI.FI Live
VITE_POLYGON_MAINNET_RPC=https://polygon-rpc.com
# Monad Mainnet (143) - Inbound Live (Mayan CCTPv2 / MCTP)
VITE_MONAD_MAINNET_RPC=https://rpc.monad.xyz
# Base Mainnet (8453) - LI.FI Live
VITE_BASE_MAINNET_RPC=https://mainnet.base.org
# Avalanche C-Chain (43114) - LI.FI Live
VITE_AVALANCHE_MAINNET_RPC=https://api.avax.network/ext/bc/C/rpc

# ── CROSS-CHAIN ROUTING & LI.FI INTEGRATION ─────────────────────
VITE_CROSS_CHAIN_ENABLED=true
VITE_LIFI_API_URL=https://li.quest/v1
# Optional: Partner / Integrator Key for LI.FI API rate limits
VITE_LIFI_API_KEY=

# ── CHAINLINK CCIP TESTNET ROUTERS ──────────────────────────────
VITE_CCIP_ROUTER_POLYGON_AMOY=0x9C32fCB86BF0f4a1A8921a9Fe46de3198bb884B2
VITE_CCIP_ROUTER_BASE_SEPOLIA=0xD3b06cEbF099CE7DA4AcCf578aaebFDBd6e88a93
VITE_CCIP_ROUTER_AVAX_FUJI=0xF694E193200268f9a4868e4Aa017A0118C9a8177

# ── SUPABASE AUDIT TRAIL ────────────────────────────────────────
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here

# ── WALLETCONNECT ───────────────────────────────────────────────
VITE_WALLETCONNECT_PROJECT_ID=3a8170812b534d0ff9d794f19a901d64
