# Fundryx Environment Configuration
# Copy to .env and fill in values. NEVER commit .env to git.

# Polygon Amoy Testnet
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology/
POLYGONSCAN_API_KEY=

# Deployer private key (testnet only, never use mainnet key)
DEPLOYER_PRIVATE_KEY=

# Monitor signer private key (separate from deployer)
MONITOR_SIGNER_PRIVATE_KEY=
